// Study-local resource overrides for the FSSC_ambrosia pangenome run.
// Passed with -c AFTER the pipeline's conf/ucr_hpcc_slurm.config. Does not
// touch nf_NovInvenio. Copied from
// studies/fungi/fusarium_FOXY_vs_FSSC/stajichlab_queue.config (itself from
// coccidioides_pangenome: preempt routing with the AVX2 node constraint, and
// the OOM fixes found at 529 and 328 strains). New here: FAMILY_PFAM_SCAN
// gets 8 h on the first attempt. In the FOXY vs FSSC runs 17 of 62 chunks hit
// the pipeline's 2 h first-attempt limit (exit 140) and reran on the 8 h retry.
process {
    withName: '.*CLUSTER_TIER1' {
        queue          = 'preempt'
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
        time           = '24.h'
    }
    withName: '.*TBLASTN_PER_STRAIN|.*COOCCURRENCE' {
        queue          = 'preempt'
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
    }
    // queue must move too: the pipeline's default first-attempt queue is
    // 'short' (2 h cap), so time=8.h alone was rejected by sbatch ("Requested
    // time limit is invalid") on the first run (2026-09-25); retries on epyc ran.
    withName: '.*FAMILY_PFAM_SCAN' {
        queue = 'epyc'
        time  = '8.h'
    }
    withName: '.*EXTRACT_ABSENT_QUERIES' {
        memory = { 16.GB * task.attempt }
    }
    withName: '.*RESCUE_PASS' {
        memory = { 32.GB * task.attempt }
    }
    withName: '.*FREQUENCY_BINS' {
        memory = { 32.GB * task.attempt }
    }
    withName: '.*ASSEMBLY_QUALITY_QC' {
        memory = { 64.GB * task.attempt }
    }
    withName: '.*EXTRACT_RESCUE_POSITIONS' {
        memory = { 32.GB * task.attempt }
    }
    withName: '.*PRESENCE_MATRIX|.*GENE_POSITIONS|.*FAMILY_POSITIONS|.*DIAGNOSTICS|.*PAIR_CLASSIFICATION|.*ISLAND.*|.*TRANS_MODULE.*|.*DETECT_.*|.*DEREPLICATE|.*ASSIGN_CLADES' {
        memory = { 16.GB * task.attempt }
    }
}
