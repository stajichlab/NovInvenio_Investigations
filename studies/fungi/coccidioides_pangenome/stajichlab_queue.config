// Route the three heaviest pangenome processes to a large-capacity partition
// for this full run, per the study's "expedite" instruction -- NOT the whole
// subworkflow (GENE_POSITIONS/PRESENCE_MATRIX/MASH_SKETCH/PREFIX_*/
// RESCUE_PASS/PAIR_CLASSIFICATION etc. stay on short/epyc, which is fine for
// their much smaller resource needs). Does not touch nf_NovInvenio itself --
// passed via -c at invocation time.
//
// 2026-09-21: moved from 'stajichlab' to 'preempt' -- the stajichlab
// partition was stopped mid-run (jobs manually requeued elsewhere), so the
// 2026-09-21 genus_vs_ureesii rescue-structural-filter validation rerun
// failed with 439 TBLASTN_PER_STRAIN tasks exhausting their retry budget.
// 'preempt' is a much larger pool (147 nodes vs. stajichlab's 5, per `sinfo`)
// with the same 30-day-class time budget need covered by CLUSTER_TIER1's
// explicit `time` override below (preempt's own limit is 7 days, still
// ample) -- accepting preemption risk in exchange for actually getting
// nodes. `clusterOptions = '--account=preempt'` is required alongside
// `queue = 'preempt'` -- see conf/ucr_hpcc_slurm.config's BUILD_CHUNK/
// FAMILY_HMMSEARCH overrides in the NovInvenio pipeline repo for the same
// paired pattern.
//
// CLUSTER_TIER1 explicitly overrides `time` here: it inherits label 'high_cpu'
// (cpus=max_cpus, memory=32GB) from conf/ucr_hpcc_slurm.config, but that
// label's default time (2h first attempt, 24h on retry) would burn a wasted
// 2h attempt on the stajichlab partition's 30-day limit before escalating --
// there's no reason to accept that on a partition sized for long jobs.
// EXTRACT_ABSENT_QUERIES OOM-killed (exit 137) on all 3 attempts during the
// real whole-set run (2026-09-15) at its inherited 'low_cpu' label default
// (4GB) -- no scaling override existed for this process anywhere in
// nf_NovInvenio, unlike COOCCURRENCE. presence_matrix.tsv at this scale is
// 182MB (47,743 tier1 families x 529 strains); the script loads the whole
// matrix into an in-memory PresenceMatrix structure, which at this cell
// count plausibly exceeds 4GB from CPython per-object overhead alone.
// Escalating 16GB->32GB, same retry-ladder pattern already used for
// CLUSTER_TIER1/COOCCURRENCE in conf/ucr_hpcc_slurm.config.
process {
    // -C ryzen|broadwell|cascade: keep off preempt's c01-c30 AMD abu_dhabi
    // nodes (no AVX2). The pipeline's own ucr_hpcc_slurm.config sets this
    // constraint for CLUSTER_TIER1, and this override used to replace it with
    // '--account=preempt' alone. 2026-09-24: both reciprocal runs (jobs
    // 29045640/41) failed CLUSTER_TIER1 on c01 with mmseqs SIGILL, 3 attempts
    // each; job 29026388's CLUSTER_TIER1 had happened to land on r42 (Milan).
    withName: '.*CLUSTER_TIER1' {
        queue          = 'preempt'
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
        time           = '24.h'
    }
    withName: '.*TBLASTN_PER_STRAIN|.*COOCCURRENCE' {
        queue          = 'preempt'
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
    }
    withName: '.*EXTRACT_ABSENT_QUERIES' {
        memory = { 16.GB * task.attempt }
    }
    // Same class of gap, found next in the same run once EXTRACT_ABSENT_QUERIES
    // was fixed: RESCUE_PASS also OOM-killed at the 'low_cpu' 4GB default on
    // all 3 attempts. It aggregates the presence_matrix.tsv (182MB) PLUS all
    // 529 strains' compressed tblastn TSVs (860MB compressed, .zst) in one
    // process -- a larger in-memory aggregate than EXTRACT_ABSENT_QUERIES,
    // so starting one tier higher (32GB, matching COOCCURRENCE's own
    // proven-safe starting point for a comparable full-strain-set aggregate
    // step in this exact pipeline) rather than repeating the same
    // under-provisioned-retry cycle.
    withName: '.*RESCUE_PASS' {
        memory = { 32.GB * task.attempt }
    }
    // Third instance of the same gap class, found immediately after
    // RESCUE_PASS succeeded: FREQUENCY_BINS OOM-killed on all 3 attempts
    // reading presence_matrix.rescued.tsv (182MB, same scale as the other
    // two). Same fix.
    withName: '.*FREQUENCY_BINS' {
        memory = { 32.GB * task.attempt }
    }
    // Fourth instance, found 2026-09-23 after 4 consecutive rescue-structural
    // validation reruns each died at the SAME step: EXTRACT_RESCUE_POSITIONS
    // OOM-killed (exit 137) on all 3 attempts every single time, because
    // NovInvenio's own conf/ucr_hpcc_slurm.config gives it a FIXED
    // `memory = '8.GB'` with no task.attempt scaling -- every retry hits the
    // identical ceiling and dies identically, then errorStrategy falls to
    // 'finish' once retries exhaust, which is what "Execution cancelled --
    // Finishing pending tasks before exit" actually was each time (Nextflow's
    // normal graceful shutdown, not an external kill or queue-move fallout,
    // as it was first mistaken for). Same aggregate-scale process as
    // RESCUE_PASS (all 530 strains' tblastn output, see
    // bin/pangenome_extract_rescue_positions.py), so same fix, same starting
    // tier. This -c file is loaded AFTER conf/ucr_hpcc_slurm.config at
    // invocation time, so this overrides that fixed 8.GB.
    withName: '.*EXTRACT_RESCUE_POSITIONS' {
        memory = { 32.GB * task.attempt }
    }
}
