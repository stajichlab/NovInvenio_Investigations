// Route the three heaviest pangenome processes to the stajichlab partition
// for this full run, per the study's "expedite with stajichlab" instruction --
// NOT the whole subworkflow (GENE_POSITIONS/PRESENCE_MATRIX/MASH_SKETCH/
// PREFIX_*/RESCUE_PASS/PAIR_CLASSIFICATION etc. stay on short/epyc, which is
// fine for their much smaller resource needs). Does not touch nf_NovInvenio
// itself -- passed via -c at invocation time.
//
// CLUSTER_TIER1 explicitly overrides `time` here: it inherits label 'high_cpu'
// (cpus=max_cpus, memory=32GB) from conf/ucr_hpcc_slurm.config, but that
// label's default time (2h first attempt, 24h on retry) would burn a wasted
// 2h attempt on the stajichlab partition's 30-day limit before escalating --
// there's no reason to accept that on a partition sized for long jobs.
// EXTRACT_ABSENT_QUERIES OOM-killed (exit 137) on all 3 attempts during the
// real whole-set run (2026-09-15) at its inherited 'low_cpu' label default
// (4GB) -- no scaling override existed for this process anywhere in
// nf_NovInvenio, unlike COOCCURRENCE. presence_matrix.tsv at this scale is
// 182MB (47,743 tier1 families x 529 strains); the script loads the whole
// matrix into an in-memory PresenceMatrix structure, which at this cell
// count plausibly exceeds 4GB from CPython per-object overhead alone.
// Escalating 16GB->32GB, same retry-ladder pattern already used for
// CLUSTER_TIER1/COOCCURRENCE in conf/ucr_hpcc_slurm.config.
process {
    withName: '.*CLUSTER_TIER1' {
        queue = 'stajichlab'
        time  = '24.h'
    }
    withName: '.*TBLASTN_PER_STRAIN|.*COOCCURRENCE' {
        queue = 'stajichlab'
    }
    withName: '.*EXTRACT_ABSENT_QUERIES' {
        memory = { 16.GB * task.attempt }
    }
    // Same class of gap, found next in the same run once EXTRACT_ABSENT_QUERIES
    // was fixed: RESCUE_PASS also OOM-killed at the 'low_cpu' 4GB default on
    // all 3 attempts. It aggregates the presence_matrix.tsv (182MB) PLUS all
    // 529 strains' compressed tblastn TSVs (860MB compressed, .zst) in one
    // process -- a larger in-memory aggregate than EXTRACT_ABSENT_QUERIES,
    // so starting one tier higher (32GB, matching COOCCURRENCE's own
    // proven-safe starting point for a comparable full-strain-set aggregate
    // step in this exact pipeline) rather than repeating the same
    // under-provisioned-retry cycle.
    withName: '.*RESCUE_PASS' {
        memory = { 32.GB * task.attempt }
    }
}
