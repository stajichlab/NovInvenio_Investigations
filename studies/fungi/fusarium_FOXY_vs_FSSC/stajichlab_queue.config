// Study-local resource overrides for the Fusarium FOXY vs FSSC pangenome runs.
// Passed with -c AFTER the pipeline's conf/ucr_hpcc_slurm.config. Does not
// touch nf_NovInvenio. Copied from
// studies/fungi/coccidioides_pangenome/stajichlab_queue.config (see that file
// for the history of each override: preempt routing with the AVX2 node
// constraint, and the OOM fixes found at 529 strains). The block at the end
// is new: this study's presence matrix is expected to be several times
// larger than Coccidioides' (two species complexes at 90% id), so the other
// low_cpu (4 GB) aggregate steps get an attempt-scaled 16 GB up front.
process {
    withName: '.*CLUSTER_TIER1' {
        queue          = 'preempt'
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
        time           = '24.h'
    }
    withName: '.*TBLASTN_PER_STRAIN|.*COOCCURRENCE' {
        queue          = 'preempt'
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
    }
    withName: '.*EXTRACT_ABSENT_QUERIES' {
        memory = { 16.GB * task.attempt }
    }
    withName: '.*RESCUE_PASS' {
        memory = { 32.GB * task.attempt }
    }
    withName: '.*FREQUENCY_BINS' {
        memory = { 32.GB * task.attempt }
    }
    // 2026-09-25: OOM (exit 137) at 16 GB on the first attempt here
    // (399,749 families x 328 strains; Coccidioides peaked at 5.4 GB).
    withName: '.*ASSEMBLY_QUALITY_QC' {
        memory = { 64.GB * task.attempt }
    }
    withName: '.*EXTRACT_RESCUE_POSITIONS' {
        memory = { 32.GB * task.attempt }
    }
    // New for this study (not yet observed to fail; preemptive).
    withName: '.*PRESENCE_MATRIX|.*GENE_POSITIONS|.*FAMILY_POSITIONS|.*DIAGNOSTICS|.*PAIR_CLASSIFICATION|.*ISLAND.*|.*TRANS_MODULE.*|.*DETECT_.*|.*DEREPLICATE|.*ASSIGN_CLADES' {
        memory = { 16.GB * task.attempt }
    }
}
