// Study-local Nextflow overrides for the A. fumigatus pangenome.nf run.
// Passed with -c AFTER the pipeline's conf/ucr_hpcc_slurm.config, so these
// settings win. Copied from
// studies/fungi/coccidioides_pangenome/stajichlab_queue.config (2026-09-25).
// See that file for the history behind each override. Summary:
// - CLUSTER_TIER1, TBLASTN_PER_STRAIN, COOCCURRENCE go to 'preempt' with the
//   AVX2 node constraint (mmseqs SIGILL on c01-c30 otherwise).
// - EXTRACT_ABSENT_QUERIES, RESCUE_PASS, FREQUENCY_BINS,
//   ASSEMBLY_QUALITY_QC, EXTRACT_RESCUE_POSITIONS OOM-killed at their label
//   defaults on the 529-strain Coccidioides runs. This study has 295 strains,
//   so the same memory ladder is an upper bound here, not a measured need.
//
// Extra for this study: beforeScript override. run_pangenome.sh runs a
// frozen `git archive` snapshot of NovInvenio (not the live checkout, which
// other sessions edit). The pipeline's default beforeScript activates the
// pixi env from ${projectDir}/pixi.toml; for a snapshot that would trigger a
// fresh pixi install per task. This points it at the live checkout's
// already-installed pixi env instead. Only the tool env comes from the live
// checkout; bin/ and lib/ come from the snapshot.
process {
    beforeScript = {
        workflow.containerEngine ? '' : """
        export PATH="\$HOME/.pixi/bin:\$PATH"
        eval "\$(pixi shell-hook -s bash --frozen --manifest-path /bigdata/stajichlab/jstajich/projects/NovInvenio/pixi.toml)"
        [ -e db ]      || ln -s /bigdata/stajichlab/jstajich/projects/NovInvenio/db db
        [ -e configs ] || ln -s ${projectDir}/configs configs
        """.stripIndent()
    }
    withName: '.*CLUSTER_TIER1' {
        queue          = 'preempt'
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
        time           = '24.h'
    }
    withName: '.*TBLASTN_PER_STRAIN|.*COOCCURRENCE' {
        queue          = 'preempt'
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
    }
    withName: '.*EXTRACT_ABSENT_QUERIES' {
        memory = { 16.GB * task.attempt }
    }
    withName: '.*RESCUE_PASS' {
        memory = { 32.GB * task.attempt }
    }
    withName: '.*FREQUENCY_BINS' {
        memory = { 32.GB * task.attempt }
    }
    withName: '.*ASSEMBLY_QUALITY_QC' {
        memory = { 16.GB * task.attempt }
    }
    withName: '.*EXTRACT_RESCUE_POSITIONS' {
        memory = { 32.GB * task.attempt }
    }
}
