// Study-specific queue override for sordariales_shallow's discovery pass.
// Routes the default (unmatched) process queue to the preemptible 'preempt'
// queue instead of conf/ucr_hpcc_slurm.config's short->epyc escalation --
// this is a cheap, retry-tolerant exploratory run (candidate discovery for
// building the third clade's controls.csv), not a production study, so
// preemption risk is acceptable in exchange for not competing for the
// short/epyc partitions.
//
// IMPORTANT: a Nextflow `withName`/`withLabel` selector's `clusterOptions`
// REPLACES the generic process-level default entirely for that selector --
// it does not merge/append. So any process that already has its own
// clusterOptions set in conf/ucr_hpcc_slurm.config (MMSEQS_CLUSTER's AVX2
// constraint, ANNOTATE_MATRIX's hmm_mpi-conditional value, the 'hmmsearch'
// label) would keep queue='preempt' from the generic default below but
// SILENTLY DROP the --account=preempt this queue requires (confirmed:
// 'preempt' partition only pairs with SLURM account 'preempt', per
// `sacctmgr show associations` -- the default account does not have access
// to it, producing "Invalid account or account/partition combination" at
// sbatch time; this broke MMSEQS_CLUSTER and ANNOTATE_MATRIX on the first
// attempt of this run, both from exactly this shadowing). Every selector in
// the base config that sets its own clusterOptions must be re-declared here
// with --account=preempt folded in, not just the generic default.
//
// Usage: nextflow run ... -profile slurm -c conf/ucr_hpcc_slurm.config -c studies/fungi/sordariales_shallow/conf_preempt.config

process {
    queue          = 'preempt'
    clusterOptions = '--account=preempt'
    errorStrategy  = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries     = 2
    // preempt's own hard cap is 1 day regardless of what's requested here.
    time           = '24.h'

    // Re-declare every base-config selector that sets its own clusterOptions,
    // so --account=preempt actually reaches sbatch for these too (see note
    // above -- these do NOT inherit it from the generic default).
    withName: '.*MMSEQS.*CLUSTER' {
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
    }
    withName: '.*CLUSTER_TIER1' {
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
    }
    withName: '(LOSS_)?ANNOTATE:ANNOTATE_MATRIX' {
        clusterOptions = { params.hmm_mpi ? "--ntasks ${params.hmm_mpi_tasks ?: params.max_cpus} --account=preempt" : '--account=preempt' }
    }
    withLabel: 'hmmsearch' {
        clusterOptions = { params.hmm_mpi ? "--ntasks ${params.hmm_mpi_tasks ?: params.max_cpus} --account=preempt" : '--account=preempt' }
    }
    // BUILD_CHUNK and HMMSEARCH_CHUNK already set --account=preempt themselves
    // in the base config -- no re-declaration needed for those two.
}
