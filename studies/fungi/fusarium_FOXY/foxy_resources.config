// Study-specific resource overrides for fusarium_FOXY (passed with -c by run.sh).
//
// BUILD_PRESENCE_MATRIX inherits low_cpu's fixed 4 GB, which does not scale on
// retry. In this study it reads 6.3 GB of parsed DIAMOND hit tables (23 genomes,
// very-sensitive mode) and was OOM-killed on all 3 attempts, for both SEARCH and
// LOSS_SEARCH (job 29088687, 2026-09-25; MaxRSS at the 4 GB limit each time).
// The Diamond-sensitivity benchmark hit the same limit (NII 1ba4e98, 16 GB).
//
// ANNOTATE_MATRIX: params.hmm_mpi defaults to true (NovInvenio e13a5ba), so the
// script runs `mpirun -np 32 hmmsearch --mpi`, which needs --ntasks slots. The
// site config's override for this is written '(LOSS_)?ANNOTATE:ANNOTATE_MATRIX',
// which does not match the qualified name NOVINVENIO:ANNOTATE:ANNOTATE_MATRIX, so
// the task got the label default (-c 32, no --ntasks) and Open MPI reported "not
// enough slots" (job 29094644). Same settings as the site override, anchored.
// SEARCH:BUILD_PRESENCE_MATRIX needed 43.6 GB (passed on the 64 GB retry).
process {
    withName: '.*BUILD_PRESENCE_MATRIX' {
        memory = { 32.GB * task.attempt }
    }
    withName: '.*ANNOTATE:ANNOTATE_MATRIX' {
        cpus           = 1
        memory         = '16.GB'
        clusterOptions = "--ntasks ${params.hmm_mpi_tasks ?: params.max_cpus}"
    }
}
