# Ephemeral, recipe-driven pulls -- never archived (DESIGN.md Sec 4). Re-fetchable
# on demand via bin/fetch_uniprot_proteome.py / bin/fetch_genome_assembly.py.
/data/
/logs/

# Per-study materialized inputs (decompressed FASTA/GFF3 built from data/ by
# bin/build_study_config.py) -- regenerable from species.csv + the cache above,
# not source. config.csv and DATA_MANIFEST.yaml (the actual tracked outputs of that
# script) are NOT excluded here since they're small and are the study's own record.
studies/*/*/data_dir/

# Per-species UniProt DR annotation extracts (bin/extract_dat_annotations.py) --
# regenerable from the (also gitignored) data/uniprot/ cache in ~2s/species, not
# source.
studies/*/*/annotations/

# Nextflow run state (when studies invoke nf_NovInvenio directly from here)
.nextflow/
.nextflow.log*
work/
.nf_launch/

# results/view of pipeline runs -- regenerated fresh per DESIGN.md Sec 9, not archived
# except via docs/*/archive/ (small derived compressed TSVs, published deliberately)
results/
view/

# TBLASTN alignment shards (nf_NovInvenio issue #73's BUILD_ALIGNMENT_SHARDS,
# relocated into the two-tier gallery path by bin/sync_reports.sh, issue #5) --
# unlike docs/*/archive/'s small TSVs, these carry real sequence text and can run
# into the multi-MB-gzipped range per genome (DESIGN.md Sec 8), so they are
# published as a GitHub Release asset (issue #1) instead of committed, and
# reassembled into docs/ only at Pages-deploy time (issue #2). Never committed
# even though they physically live under docs/ on local disk.
docs/*/*/alignments/
docs/*/*/loss_alignments/

# pixi
.pixi/*
!.pixi/config.toml

# python
__pycache__/
*.pyc

# Claude Code / mycelium session-local state
.claude/*.tmp
.claude/*.log
.claude/settings.local.json
.mycelium/locks/
