#!/usr/bin/env python3
"""ni: dataset resolution and config assembly for a new NII study.

See notes/superpowers/specs/2026-09-11-ni-dataset-resolution-design.md.

Usage:
  bin/ni resolve  --study-dir studies/<domain>/<set>
  bin/ni fetch    --study-dir studies/<domain>/<set> [-- extra build_study_config.py args]
  bin/ni discover --species "<name>" --study-dir studies/<domain>/<set>
                  [--ingroup-groups G1,G2] [--outgroup-groups G3] [--auto]
                  [--include-species-complex]
  bin/ni run      --study-dir studies/<domain>/<set> [-- extra nextflow args]
"""
import argparse
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ni_resolve import resolve_species_csv  # noqa: E402

BIN = Path(__file__).parent


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)

    resolve_ap = sub.add_parser("resolve", help="Fill in species.csv's source columns")
    resolve_ap.add_argument("--study-dir", required=True)

    fetch_ap = sub.add_parser("fetch", help="Pass through to bin/build_study_config.py")
    fetch_ap.add_argument("--study-dir", required=True)
    fetch_ap.add_argument("extra_args", nargs=argparse.REMAINDER)

    discover_ap = sub.add_parser("discover", help="Enumerate a species' NCBI genomes into a new study's species.csv")
    discover_ap.add_argument("--species", required=True)
    discover_ap.add_argument("--study-dir", required=True)
    discover_ap.add_argument("--ingroup-groups", default=None, help="Comma-separated group labels")
    discover_ap.add_argument("--outgroup-groups", default=None, help="Comma-separated group labels")
    discover_ap.add_argument(
        "--auto", action="store_true",
        help=(
            "Print an extended, informational proposal (largest/best-sampled named group, "
            "cross-group duplicate strains, sibling species in the complex) in addition to the "
            "group/count table. Report-only: Group is still written blank for every row, exactly "
            "like the default mode -- never combine with --ingroup-groups/--outgroup-groups."
        ),
    )
    discover_ap.add_argument(
        "--include-species-complex", action="store_true",
        help=(
            "Query the species' parent NCBI species-group/complex node instead of the literal "
            "species name, pulling in every sibling species registered under a different name "
            "within the same complex (e.g. Fusarium odoratissimum/TR4 genomes that a plain "
            "'Fusarium oxysporum' query never sees). Without this flag, discover still reports "
            "how many additional genomes exist in the complex, but only enumerates the literal "
            "species queried."
        ),
    )

    run_ap = sub.add_parser("run", help="Pass through to bin/run_study.sh (build if needed, then launch nextflow)")
    run_ap.add_argument("--study-dir", required=True)
    run_ap.add_argument("extra_args", nargs=argparse.REMAINDER)

    args = ap.parse_args()

    if args.command == "resolve":
        resolve_species_csv(Path(args.study_dir))
        return 0

    if args.command == "fetch":
        cmd = [sys.executable, str(BIN / "build_study_config.py"), "--study-dir", args.study_dir]
        cmd.extend(a for a in args.extra_args if a != "--")
        result = subprocess.run(cmd)
        return result.returncode

    if args.command == "discover":
        from ni_discover import discover_species

        def _split_groups(raw: str | None) -> list[str] | None:
            if not raw:
                return None
            tokens = [t.strip() for t in raw.split(",")]
            tokens = [t for t in tokens if t]
            return tokens or None

        discover_species(
            args.species,
            Path(args.study_dir),
            ingroup_groups=_split_groups(args.ingroup_groups),
            outgroup_groups=_split_groups(args.outgroup_groups),
            auto=args.auto,
            include_species_complex=args.include_species_complex,
        )
        return 0

    if args.command == "run":
        repo_root = BIN.parent
        studies_root = (repo_root / "studies").resolve()
        study_path = Path(args.study_dir).resolve()
        try:
            study_rel = study_path.relative_to(studies_root)
        except ValueError:
            print(
                f"ERROR: --study-dir {args.study_dir} is not under {studies_root} "
                "(bin/run_study.sh takes a studies/-relative <domain>/<set_name>)",
                file=sys.stderr,
            )
            return 1
        cmd = [str(repo_root / "run_study.sh"), str(study_rel)]
        cmd.extend(a for a in args.extra_args if a != "--")
        result = subprocess.run(cmd)
        return result.returncode

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
