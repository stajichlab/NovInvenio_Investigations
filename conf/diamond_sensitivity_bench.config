// Diamond-sensitivity benchmark (notes/diamond-sensitivity/README.md).
// Apply after conf/ucr_hpcc_slurm.config (from the pipeline checkout).
//
// Workers go to 'preempt' with --account=preempt, as in
// studies/fungi/sordariales_shallow/conf_preempt.config. A withName/withLabel
// clusterOptions REPLACES the generic one, so every selector that sets its own
// clusterOptions must carry --account=preempt again.
//
// The diamond steps are pinned to one CPU generation (AMD Milan, 36 preempt
// nodes, 2026-09-23) so that default / sensitive / very-sensitive are timed on
// the same hardware. Only COMPLETED task realtime is used for cost; preempted
// attempts (exit 143) are retried and not counted.

process {
    queue          = 'preempt'
    clusterOptions = '--account=preempt'
    errorStrategy  = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries     = 2
    time           = '24.h'

    withName: '.*DIAMOND_(SEARCH|SELF|MAKEDB)' {
        clusterOptions = '-C milan --account=preempt'
    }
    withName: '.*MMSEQS.*CLUSTER' {
        clusterOptions = '-C ryzen|broadwell|cascade --account=preempt'
    }
    withName: '(LOSS_)?ANNOTATE:ANNOTATE_MATRIX' {
        clusterOptions = { params.hmm_mpi ? "--ntasks ${params.hmm_mpi_tasks ?: params.max_cpus} --account=preempt" : '--account=preempt' }
    }
    withLabel: 'hmmsearch' {
        clusterOptions = { params.hmm_mpi ? "--ntasks ${params.hmm_mpi_tasks ?: params.max_cpus} --account=preempt" : '--account=preempt' }
    }
}
